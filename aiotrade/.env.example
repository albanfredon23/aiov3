# Copier en .env (jamais versionné : voir .gitignore) puis compléter.
# Lancement : docker compose --profile trading up -d trader

# paper (défaut : données publiques, aucun ordre) | binance (testnet ou live selon AIOTRADE_BINANCE_ENV)
AIOTRADE_BROKER=paper
AIOTRADE_SYMBOL=BTCUSDT

# --- Testnet Binance Spot (https://testnet.binance.vision) ---
AIOTRADE_BINANCE_ENV=testnet
AIOTRADE_BINANCE_API_KEY=
AIOTRADE_BINANCE_API_SECRET=
# 0 = ordres validés par la plateforme sans exécution (/api/v3/order/test) ; 1 = ordres exécutés
AIOTRADE_SEND_ORDERS=0
# Plafond de notionnel par ordre (en USDT)
AIOTRADE_MAX_ORDER_NOTIONAL=1000

# --- Live : à n'activer qu'après la check-list du README ---
# AIOTRADE_BINANCE_ENV=live
# AIOTRADE_LIVE_TRADING=JE_COMPRENDS_LES_RISQUES
# AIOTRADE_BINANCE_LIVE_API_KEY=      (clé dédiée : trading seul, retraits désactivés, liste blanche d'IP)
# AIOTRADE_BINANCE_LIVE_API_SECRET=
# AIOTRADE_MAX_ORDER_NOTIONAL=50
